# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  .env.example — шаблон переменных окружения                               ║
# ║                                                                            ║
# ║  Скопируй в .env и заполни реальными значениями:                           ║
# ║    cp .env.example .env                                                    ║
# ║                                                                            ║
# ║  ВАЖНО: .env добавлен в .gitignore — никогда не коммить реальные секреты.  ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

NODE_ENV=development

# ── Порты сервисов ─────────────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
CORE_SERVICE_PORT=3001
REVIEW_SERVICE_PORT=3002
AI_SERVICE_PORT=3003
INTEGRATION_SERVICE_PORT=3004
MAP_PARSER_PORT=3005

# ── База данных ────────────────────────────────────────────────────────────────
#
# Для локальной разработки (вне Docker): @localhost:5432
# Для Docker Compose: docker-compose.yml переопределяет хост на @postgres:5432
# (имя сервиса в Docker-сети)
POSTGRES_DB=geomarketing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geomarketing

# ── Redis ──────────────────────────────────────────────────────────────────────
#
# Для локальной разработки: localhost
# В Docker Compose переопределяется на имя сервиса `redis`
REDIS_HOST=localhost
REDIS_PORT=6379

# ── RabbitMQ ───────────────────────────────────────────────────────────────────
#
# Для локальной разработки: localhost
# В Docker Compose переопределяется на amqp://$RABBITMQ_DEFAULT_USER:$RABBITMQ_DEFAULT_PASS@rabbitmq:5672
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Креды для самого контейнера rabbitmq (docker-compose.yml) — RABBITMQ_URL
# выше должен совпадать с ними при локальном запуске нативных процессов.
# ОБЯЗАТЕЛЬНО смени в production — дефолт guest:guest только для dev.
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ── Сессии (api-gateway) ───────────────────────────────────────────────────────
#
# ОБЯЗАТЕЛЬНО смени в production на случайную строку длиной 64+ символа.
# Генерация: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# В production переменная обязательна — без неё api-gateway не стартует.
SESSION_SECRET=change-me-in-production

# ── CORS (api-gateway) ─────────────────────────────────────────────────────────
#
# Список разрешённых origin через запятую, например:
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Если пусто — gateway отражает любой origin (удобно для dev, небезопасно для prod).
CORS_ORIGINS=

# ── RPC-таймауты (api-gateway) ──────────────────────────────────────────────────
#
# Таймаут (мс) по умолчанию для RPC-запросов к сервисам через RabbitMQ.
# Не задано — используется 5000 (см. apps/api-gateway/src/common/rpc.ts).
RPC_TIMEOUT_MS=

# ── 2ГИС (map-parser) ─────────────────────────────────────────────────────────
TWO_GIS_LOGIN=your-login@example.com
TWO_GIS_PASSWORD=your-password
TWO_GIS_API_KEY=your-api-key

# Общий токен api-gateway↔map-parser (единственный внутренний сервис без
# RabbitMQ, вызывается по обычному HTTP) — map-parser отклоняет запросы без
# совпадающего заголовка X-Internal-Token. ОБЯЗАТЕЛЬНО сменить в production.
MAP_PARSER_INTERNAL_TOKEN=dev-internal-token-change-in-prod

# ── Яндекс Geosearch API (поиск/превью организаций, search-maps.yandex.ru) ─────
# Ключ из Кабинета Разработчика: https://developer.tech.yandex.ru/
YANDEX_GEOSEARCH_API_KEY=your-api-key

# ── Resend (отправка писем, api-gateway) ────────────────────────────────────────
#
# Ключ из дашборда resend.com (API Keys → Create API Key), бесплатный тариф.
# Если не задан — Team-инвайты не отправляются письмом, токен печатается в
# лог сервера в non-production (см. apps/api-gateway/src/team/team.controller.ts).
RESEND_API_KEY=
