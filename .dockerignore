# Зависимости — они устанавливаются внутри образа, не копируем снаружи
node_modules

# Собранные артефакты (пересобираются внутри образа)
dist

# Git-история не нужна в образе
.git
.gitignore

# Секреты — никогда не должны попадать в образ
.env
.env.*

# Документация, тесты, покрытие — не нужны в runtime
docs
coverage
.nyc_output

# IDE-файлы
.vscode
.idea

# Логи и временные файлы
*.log
.temp
.tmp
