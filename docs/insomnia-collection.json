    {
      "_id": "fld_templates",
      "_type": "request_group",
      "parentId": "wrk_geo",
      "name": "Templates",
      "description": "Шаблоны карточек на уровне бренда. Содержат плоские дефолтные значения полей (names, phones, address и т.д.). Компания может подключить шаблон и переопределять отдельные поля через /companies/:id/default. Все запросы требуют X-Brand-Id и активной сессии."
    },

    {
      "_id": "req_templates_list",
      "_type": "request",
      "parentId": "fld_templates",
      "name": "List Templates",
      "method": "GET",
      "url": "{{ base_url }}/templates",
      "description": "Все шаблоны бренда, отсортированы по createdAt.",
      "body": {},
      "headers": [{ "name": "X-Brand-Id", "value": "{{ brand_id }}" }],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_templates_create",
      "_type": "request",
      "parentId": "fld_templates",
      "name": "Create Template",
      "method": "POST",
      "url": "{{ base_url }}/templates",
      "description": "Создаёт шаблон. fields — плоский объект с дефолтными значениями полей карточки.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Основной шаблон\",\n  \"fields\": {\n    \"names\": [\n      { \"lang\": \"ru\", \"val\": \"Кофейня Арома\" },\n      { \"lang\": \"en\", \"val\": \"Aroma Coffee\" }\n    ],\n    \"phones\": [\n      { \"value\": \"+79001234567\", \"comment\": \"Основной\" }\n    ],\n    \"websites\": [\"https://example.com\"],\n    \"schedule\": {\n      \"Mon\": { \"working_hours\": [{ \"from\": \"09:00\", \"to\": \"18:00\" }] },\n      \"Tue\": { \"working_hours\": [{ \"from\": \"09:00\", \"to\": \"18:00\" }] },\n      \"Wed\": { \"working_hours\": [{ \"from\": \"09:00\", \"to\": \"18:00\" }] },\n      \"Thu\": { \"working_hours\": [{ \"from\": \"09:00\", \"to\": \"18:00\" }] },\n      \"Fri\": { \"working_hours\": [{ \"from\": \"09:00\", \"to\": \"18:00\" }] }\n    },\n    \"mainCategory\": { \"id\": \"666\", \"name\": \"Кофейня\" },\n    \"descriptions\": [\n      { \"lang\": \"ru\", \"val\": \"Сеть уютных кофеен\" }\n    ]\n  }\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Brand-Id", "value": "{{ brand_id }}" }
      ],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_templates_update",
      "_type": "request",
      "parentId": "fld_templates",
      "name": "Update Template",
      "method": "PATCH",
      "url": "{{ base_url }}/templates/{{ template_id }}",
      "description": "Обновляет name и/или fields шаблона. Только участник бренда.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Обновлённый шаблон\",\n  \"fields\": {\n    \"names\": [\n      { \"lang\": \"ru\", \"val\": \"Новое название\" }\n    ]\n  }\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "parameters": [],
      "authentication": {}
    },

