      "_id": "req_templates_delete",
      "_type": "request",
      "parentId": "fld_templates",
      "name": "Delete Template",
      "method": "DELETE",
      "url": "{{ base_url }}/templates/{{ template_id }}",
      "description": "Удаляет шаблон. Компании которые его использовали — отвязываются (templateId → null), данные не теряются. Возвращает 204.",
      "body": {},
      "headers": [],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "fld_companies",
      "_type": "request_group",
      "parentId": "wrk_geo",
      "name": "Companies",
      "description": "CRUD компаний (филиалов). Все запросы требуют активной сессии."
    },

    {
      "_id": "req_companies_list",
      "_type": "request",
      "parentId": "fld_companies",
      "name": "List Companies",
      "method": "GET",
      "url": "{{ base_url }}/companies",
      "description": "Компании бренда с пагинацией. Возвращает { items, total, page, limit }.",
      "body": {},
      "headers": [{ "name": "X-Brand-Id", "value": "{{ brand_id }}" }],
      "parameters": [
        { "name": "page", "value": "1" },
        { "name": "limit", "value": "20" }
      ],
      "authentication": {}
    },

    {
      "_id": "req_companies_get",
      "_type": "request",
      "parentId": "fld_companies",
      "name": "Get Company (full)",
      "method": "GET",
      "url": "{{ base_url }}/companies/{{ company_id }}",
      "description": "Полный профиль: базовые поля + card + platforms.\n\ncard.fields — per-field структура:\n{\n  \"names\": {\n    \"isException\": true,       // true = своё значение, false = из шаблона\n    \"default\": [...],          // итоговое значение (из шаблона или компании)\n    \"platforms\": {             // только если есть переопределения\n      \"yandex\": [...]\n    }\n  }\n}",
      "body": {},
      "headers": [],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_companies_create",
      "_type": "request",
      "parentId": "fld_companies",
      "name": "Create Company",
      "method": "POST",
      "url": "{{ base_url }}/companies",
      "description": "Создаёт компанию. Автоматически создаёт company_defaults (пустой, можно указать templateId) и платформы yandex + twogis со статусом not_connected.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Кофейня Арома на Ленина\",\n  \"code\": \"BRANCH-001\",\n  \"templateId\": \"\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "X-Brand-Id", "value": "{{ brand_id }}" }
      ],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_companies_delete",
      "_type": "request",
      "parentId": "fld_companies",
      "name": "Delete Company",
      "method": "DELETE",
      "url": "{{ base_url }}/companies/{{ company_id }}",
      "description": "Soft-delete: ставит status=deleted. Любой участник бренда. Возвращает 204.",
      "body": {},
      "headers": [],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_companies_update_default",
      "_type": "request",
      "parentId": "fld_companies",
      "name": "Update Company Default (card)",
      "method": "PATCH",
      "url": "{{ base_url }}/companies/{{ company_id }}/default",
      "description": "Обновляет карточку компании. Можно передать templateId и/или fieldOverrides.\n\nfieldOverrides — объект вида { fieldName: { isException, value?, platforms? } }.\nМердж на уровне поля: поля которые не указаны — не трогаются.\n\nЕсли isException: false — поле берётся из шаблона (value игнорируется).\nЕсли isException: true — используется value, опционально с переопределениями под платформы.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"templateId\": \"{{ template_id }}\",\n  \"fieldOverrides\": {\n    \"names\": {\n      \"isException\": true,\n      \"value\": [\n        { \"lang\": \"ru\", \"val\": \"Кофейня Арома1\" },\n        { \"lang\": \"en\", \"val\": \"Aroma Coffee\" }\n      ],\n      \"platforms\": {\n        \"yandex\": [\n          { \"lang\": \"en\", \"val\": \"Aroma Coffee2\" }\n        ]\n      }\n    },\n    \"phones\": {\n      \"isException\": false\n    }\n  }\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_companies_update_platform",
      "_type": "request",
      "parentId": "fld_companies",
      "name": "Update Company Platform",
      "method": "PATCH",
      "url": "{{ base_url }}/companies/{{ company_id }}/platforms/yandex",
      "description": "Обновляет настройки подключения платформы: isEnabled, orgId, orgName, status. platformKey в URL — произвольная строка (yandex, twogis, google и т.д.). Контентные переопределения хранятся в /default (fieldOverrides.*.platforms).",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"isEnabled\": true,\n  \"orgId\": \"123456789\",\n  \"orgName\": \"Кофейня Арома\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "parameters": [],
      "authentication": {}
    },

