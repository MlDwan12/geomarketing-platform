{
  "_type": "export",
  "__export_format": 4,
  "__export_date": "2026-06-19",
  "__export_source": "geomarketing-platform",
  "resources": [
    {
      "_id": "wrk_geo",
      "_type": "workspace",
      "parentId": null,
      "name": "Geomarketing Platform",
      "description": "API коллекция для geomarketing-platform (api-gateway :3000)",
      "scope": "collection"
    },

    {
      "_id": "env_geo_base",
      "_type": "environment",
      "parentId": "wrk_geo",
      "name": "Local",
      "data": {
        "base_url": "http://localhost:3000",
        "test_email": "test@example.com",
        "test_password": "password123",
        "reset_token": ""
      },
      "color": "#4CAF50",
      "isPrivate": false
    },

    {
      "_id": "jar_geo",
      "_type": "cookie_jar",
      "parentId": "wrk_geo",
      "name": "Default Jar",
      "cookies": []
    },

    {
      "_id": "fld_auth",
      "_type": "request_group",
      "parentId": "wrk_geo",
      "name": "Auth",
      "description": "Регистрация, логин, профиль, сброс пароля. Сессия хранится в куке connect.sid — Insomnia передаёт её автоматически через cookie jar."
    },

    {
      "_id": "req_register",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Register",
      "method": "POST",
      "url": "{{ base_url }}/auth/register",
      "description": "Создаёт аккаунт и открывает сессию. referralCode — опциональный.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Иван Петров\",\n  \"email\": \"{{ test_email }}\",\n  \"password\": \"{{ test_password }}\",\n  \"referralCode\": \"\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_login",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Login",
      "method": "POST",
      "url": "{{ base_url }}/auth/login",
      "description": "Открывает сессию. Возвращает объект юзера (без passwordHash).",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ test_email }}\",\n  \"password\": \"{{ test_password }}\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_me",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Me (current user)",
      "method": "GET",
      "url": "{{ base_url }}/auth/me",
      "description": "Возвращает профиль текущего авторизованного пользователя. Требует активной сессии.",
      "body": {},
      "headers": [],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_update_profile",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Update Profile",
      "method": "PATCH",
      "url": "{{ base_url }}/auth/profile",
      "description": "Обновляет поля профиля. Все поля опциональны — передавай только те, что меняешь.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Иван Петров\",\n  \"fullName\": \"Иванов Иван Иванович\",\n  \"phone\": \"+79001234567\",\n  \"telegram\": \"@ivanpetrov\",\n  \"timezone\": \"Europe/Moscow\",\n  \"locale\": \"ru\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_update_avatar",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Update Avatar",
      "method": "PATCH",
      "url": "{{ base_url }}/auth/avatar",
      "description": "Обновляет ссылку на аватар. Передаётся готовый URL (после загрузки файла на CDN).",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"avatarUrl\": \"https://cdn.example.com/avatars/user-123.jpg\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_change_password",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Change Password",
      "method": "PATCH",
      "url": "{{ base_url }}/auth/password",
      "description": "Меняет пароль. Требует текущий пароль для подтверждения.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"currentPassword\": \"{{ test_password }}\",\n  \"newPassword\": \"newpassword456\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_forgot_password",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Forgot Password",
      "method": "POST",
      "url": "{{ base_url }}/auth/forgot-password",
      "description": "Создаёт токен сброса пароля. В dev-режиме токен печатается в консоль сервера вместо отправки email.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ test_email }}\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_reset_password",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Reset Password",
      "method": "POST",
      "url": "{{ base_url }}/auth/reset-password",
      "description": "Применяет токен из письма и устанавливает новый пароль. Токен одноразовый. Скопируй из консоли сервера в переменную reset_token.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"token\": \"{{ reset_token }}\",\n  \"password\": \"newpassword789\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_logout",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Logout",
      "method": "POST",
      "url": "{{ base_url }}/auth/logout",
      "description": "Уничтожает сессию в Redis и очищает куку. После этого /auth/me вернёт 401.",
      "body": {},
      "headers": [],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "fld_brands",
      "_type": "request_group",
      "parentId": "wrk_geo",
      "name": "Brands",
      "description": "CRUD брендов. Все ручки требуют активной сессии (SessionGuard)."
    },

    {
      "_id": "req_brands_list",
      "_type": "request",
      "parentId": "fld_brands",
      "name": "List Brands",
      "method": "GET",
      "url": "{{ base_url }}/brands",
      "description": "Возвращает все бренды, в которых текущий пользователь является участником (owner или member через user_brands).",
      "body": {},
      "headers": [],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_brands_list_short",
      "_type": "request",
      "parentId": "fld_brands",
      "name": "List Brands Short",
      "method": "GET",
      "url": "{{ base_url }}/brands/short",
      "description": "Короткий список (id, name, slug, logoUrl) для свитчера брендов в UI.",
      "body": {},
      "headers": [],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_brands_get",
      "_type": "request",
      "parentId": "fld_brands",
      "name": "Get Brand",
      "method": "GET",
      "url": "{{ base_url }}/brands/BRAND_ID_HERE",
      "description": "Возвращает один бренд. 403 если пользователь не является участником.",
      "body": {},
      "headers": [],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_brands_create",
      "_type": "request",
      "parentId": "fld_brands",
      "name": "Create Brand",
      "method": "POST",
      "url": "{{ base_url }}/brands",
      "description": "Создаёт бренд. Автоматически генерирует slug из name. Создаёт запись user_brands с ролью owner.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Мой бренд\",\n  \"timezone\": \"Europe/Moscow\",\n  \"description\": \"Описание бренда\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_brands_update",
      "_type": "request",
      "parentId": "fld_brands",
      "name": "Update Brand",
      "method": "PATCH",
      "url": "{{ base_url }}/brands/BRAND_ID_HERE",
      "description": "Обновляет поля бренда. Только owner может редактировать. Если меняется name — slug пересчитывается.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Новое название\",\n  \"description\": \"Обновлённое описание\",\n  \"timezone\": \"Europe/Moscow\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "parameters": [],
      "authentication": {}
    }
  ]
}
