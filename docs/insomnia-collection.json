    {
      "_id": "req_import_single",
      "_type": "request",
      "parentId": "fld_import",
      "name": "Import Org (один бренд)",
      "method": "POST",
      "url": "{{ base_url }}/import/2gis",
      "description": "Импортирует одну организацию 2ГИС как бренд и все её филиалы как компании. Подтягивает рейтинг, отзывы, категории и расписание из Catalog API.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"orgId\": \"{{ twogis_org_id }}\",\n  \"timezone\": \"Europe/Moscow\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "parameters": [],
      "authentication": {}
    },

    {
      "_id": "req_import_sync",
      "_type": "request",
      "parentId": "fld_import",
      "name": "Sync All Orgs (все бренды)",
      "method": "POST",
      "url": "{{ base_url }}/import/2gis/sync",
      "description": "Синхронизирует все организации из ЛК 2ГИС. Активные → бренд active. Неактивные → бренд suspended. Уже импортированные филиалы (по orgId в company_platforms) — skipped.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"timezone\": \"Europe/Moscow\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "parameters": [],
      "authentication": {}
    },

